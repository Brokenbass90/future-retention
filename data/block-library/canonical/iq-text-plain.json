{
  "id": "iq-text-plain",
  "label": "Обычный текст",
  "description": "p.text 18px тёмно-серый.",
  "placement": "inner",
  "category": "text",
  "version": 3,
  "outlookSafe": true,
  "pug": "p.iq-text-plain--text.iq-text-plain(style=\"text-align:{{ align }}\") {{ text }}",
  "styl": ".iq-text-plain--text\n  font-family: Helvetica !important\n  font-size: 18px\n  color: #393A44\n  letter-spacing: 0\n  line-height: 26px\n  font-weight 400",
  "slots": [
    {
      "id": "text",
      "kind": "richText",
      "label": "Текст",
      "default": "Body text",
      "uiGroup": "content"
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "left",
      "options": [
        "left",
        "center",
        "right"
      ],
      "uiGroup": "appearance"
    }
  ],
  "scoped": true
}
