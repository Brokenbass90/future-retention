{
  "id": "iqbr-logo",
  "label": "Логотип IQ Broker",
  "description": "Логотип со ссылкой, по центру, с отступами сверху и снизу.",
  "placement": "inner",
  "category": "header",
  "version": 1,
  "pug": "a(href=\"{{ href }}\" universal=\"true\" target=\"_blank\")\n    img.logo.iqbr-logo--logo.center.iqbr-logo--center(src=\"{{ logo }}\" alt=\"{{ alt }}\")",
