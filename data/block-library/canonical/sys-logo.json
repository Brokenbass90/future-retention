{
  "id": "sys-logo",
  "label": "Логотип",
  "description": "Логотип со ссылкой. Ширина и выравнивание настраиваются.",
  "placement": "inner",
  "category": "header",
  "version": 1,
  "pug": "table.sys-logo--box(role=\"presentation\" width=\"100%\")\n    tr\n        td(align=\"{{ align }}\" style=\"padding:{{ padding }};text-align:{{ align }}\")\n            a(href=\"{{ href }}\" universal=\"true\" target=\"_blank\")\n                img.sys-logo--img(src=\"{{ image }}\" alt=\"{{ alt }}\" width=\"{{ width }}\" style=\"border:0;display:inline-block;height:auto;max-width:{{ width }}px\")",
  "styl": ".sys-logo--box{width:100%;border-collapse:collapse}\n.sys-logo--img{display:inline-block;height:auto}",
  "slots": [
    {
      "id": "image",
      "kind": "select",
      "label": "Логотип",
      "default": "https://fsms.quadcode.com/storage/public/cu/uq/33bjqakjdvu1n1f0/iq-logo-small.png",
      "uiGroup": "assets",
      "options": [
        {
          "value": "https://fsms.quadcode.com/storage/public/cu/uq/33bjqakjdvu1n1f0/iq-logo-small.png",
          "label": "Тёмное (на светлом фоне)"
        },
        {
          "value": "https://fsms.quadcode.com/storage/public/cs/gd/i86di3umufauu84g/Logotype%202.png",
          "label": "Белое (на тёмном фоне)"
        }
      ]
    },
    {
      "id": "href",
      "kind": "url",
      "label": "Ссылка логотипа",
      "default": "#",
      "uiGroup": "content"
    },
    {
      "id": "alt",
      "kind": "text",
      "label": "Alt-текст",
      "default": "IQ Option",
      "uiGroup": "content"
    },
    {
      "id": "width",
      "kind": "number",
      "label": "Ширина, px",
      "default": 138,
      "uiGroup": "appearance",
      "min": 40,
      "max": 320
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "center",
      "uiGroup": "appearance",
      "options": [
        "left",
        "center",
        "right"
      ]
    },
    {
      "id": "padding",
      "kind": "text",
      "label": "Внутренние отступы",
      "default": "0",
      "uiGroup": "appearance"
    }
  ],
  "kits": [
    "system",
    "promo"
  ],
  "outlookSafe": true,
  "tags": [
    "logo",
    "header"
  ],
  "note": "Системный набор: блок написан с нуля под простые сервисные письма. Базовые цвета берутся из темы бренда ($brand_*), поэтому один и тот же блок читается и на светлом IQ Option, и на тёмном IQ Broker. Пустое значение цветового слота = «по бренду».",
  "scoped": true
}
