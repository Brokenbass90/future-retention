{
  "id": "sys-button",
  "label": "Кнопка",
  "description": "Кнопка письма. Ширина выбирается: во всю ширину секции, классические 280px или по длине текста. На мобильном всегда во всю ширину.",
  "placement": "inner",
  "category": "cta",
  "version": 1,
  "pug": "table.sys-button--box(align=\"{{ align }}\" role=\"presentation\" width=\"{{ width }}\" style=\"width:{{ width_css }};{{ align_css }}\")\n    tr\n        td.sys-button--cell(style=\"background-color:{{ background_color }};border-radius:{{ radius }}\")\n            a.sys-button--link(href=\"{{ href }}\" universal=\"true\" target=\"_blank\" style=\"color:{{ text_color }}\") {{ label }}",
  "styl": ".sys-button--box{border-collapse:separate !important}\n@media screen and (max-width: 600px){.sys-button--box{width:100% !important;max-width:100% !important}}\n.sys-button--cell{background-color:$brand_primary;border-radius:12px;text-align:center}\n.sys-button--link{display:block;padding:18px 32px;color:$brand_primary_text;font-family:Helvetica,Arial,sans-serif !important;font-size:16px;font-weight:700;line-height:22px;text-align:center;text-decoration:none}",
  "slots": [
    {
      "id": "label",
      "kind": "text",
      "label": "Текст кнопки",
      "default": "Перейти",
      "uiGroup": "content"
    },
    {
      "id": "href",
      "kind": "url",
      "label": "Ссылка",
      "default": "#",
      "uiGroup": "content",
      "allowSystemPlaceholder": true
    },
    {
      "id": "width",
      "kind": "select",
      "label": "Ширина",
      "default": "280",
      "uiGroup": "appearance",
      "options": [
        {
          "value": "280",
          "label": "280 px — классическая"
        },
        {
          "value": "100%",
          "label": "Во всю ширину секции"
        },
        {
          "value": "auto",
          "label": "По длине текста"
        }
      ]
    },
    {
      "id": "width_css",
      "kind": "text",
      "label": "Ширина в CSS",
      "default": "280px",
      "uiGroup": "appearance"
    },
    {
      "id": "align_css",
      "kind": "text",
      "label": "Прижатие",
      "default": "margin:0",
      "uiGroup": "appearance"
    },
    {
      "id": "background_color",
      "kind": "color",
      "label": "Цвет кнопки — пусто значит «по теме бренда»",
      "default": "",
      "uiGroup": "appearance"
    },
    {
      "id": "text_color",
      "kind": "color",
      "label": "Цвет текста — пусто значит «по теме бренда»",
      "default": "",
      "uiGroup": "appearance"
    },
    {
      "id": "radius",
      "kind": "select",
      "label": "Скругление",
      "default": "12px",
      "uiGroup": "appearance",
      "options": [
        "0",
        "4px",
        "8px",
        "12px",
        "16px",
        "24px"
      ]
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "left",
      "uiGroup": "appearance",
      "options": [
        "left",
        "center",
        "right"
      ]
    }
  ],
  "kits": [
    "system",
    "promo"
  ],
  "outlookSafe": true,
  "tags": [
    "cta",
    "button"
  ],
  "note": "Системный набор: блок написан с нуля под простые сервисные письма. Базовые цвета берутся из темы бренда ($brand_*), поэтому один и тот же блок читается и на светлом IQ Option, и на тёмном IQ Broker. Пустое значение цветового слота = «по бренду».",
  "scoped": true,
  "slotPresets": {
    "width": {
      "280": {
        "width_css": "280px"
      },
      "100%": {
        "width_css": "100%"
      },
      "auto": {
        "width_css": "auto"
      }
    },
    "align": {
      "left": {
        "align_css": "margin:0"
      },
      "center": {
        "align_css": "margin:0 auto"
      },
      "right": {
        "align_css": "margin:0 0 0 auto"
      }
    }
  }
}
