{
  "id": "iqbr-block-title",
  "label": "Подзаголовок блока (IQ Broker)",
  "description": "Заголовок внутри тёмной колонки, 24/31.",
  "placement": "inner",
  "category": "text",
  "version": 1,
  "pug": "p.iqbr-block-title--block-title(style=\"color:{{ color }};padding-bottom:{{ padding_bottom }}\") {{ text }}",
  "styl": ".iqbr-block-title--block-title{font-family:Helvetica !important;font-style:normal;font-weight:700;font-size:24px;line-height:31px;color:#ececed}",
  "slots": [
    {
      "id": "text",
      "kind": "text",
      "label": "Текст",
      "default": "Подзаголовок",
      "uiGroup": "content"
    },
    {
      "id": "color",
      "kind": "color",
      "label": "Цвет",
      "default": "#ECECED",
      "uiGroup": "appearance"
    },
    {
      "id": "padding_bottom",
      "kind": "select",
      "label": "Отступ снизу",
      "default": "16px",
      "options": [
        "0",
        "8px",
        "12px",
        "16px",
        "24px"
      ],
      "uiGroup": "appearance"
    }
  ],
  "outlookSafe": true,
  "tags": [
    "iqbroker",
    "text"
  ],
  "note": "Нарезано из email-base/X_IQBroker/mail-strategies. Семейные стили втянуты в блок и заскоуплены; ink-классы (.row/.columns/.wrapper) оставлены глобальными.",
  "scoped": true
}
