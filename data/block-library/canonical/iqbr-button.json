{
  "id": "iqbr-button",
  "label": "Кнопка (IQ Broker)",
  "description": "Оранжевая кнопка шириной до 280px, на мобильном — во всю ширину.",
  "placement": "inner",
  "category": "cta",
  "version": 1,
  "pug": "table.iqbr-button--w280(align=\"{{ align }}\" style=\"width: 100%;\")\n    tr\n        td.butt.iqbr-button--butt.pb0.iqbr-button--pb0(style=\"background-color:{{ background_color }};border-radius:{{ radius }}\")\n            a.iqbr-button--butt-link(href=\"{{ href }}\" universal=\"true\" target=\"_blank\" style=\"color:{{ text_color }}\") {{ label }}",
  "styl": ".iqbr-button--w280{width:100%;max-width:280px}\n@media screen and (max-width: 600px){.iqbr-button--w280{max-width:100% !important}}\n.iqbr-button--butt{background-size:cover;background-color:#f50;font-size:18px !important;font-weight:700 !important;border-radius:12px !important;text-transform:none;font-family:Helvetica !important;height:auto}\n.iqbr-button--butt-link{font-size:18px;line-height:27px;font-weight:700;text-transform:none;text-decoration:none;color:#f9f9f9;display:block;padding:16px 0 16px;text-align:center;letter-spacing:0px}\n.iqbr-button--pb0{padding-bottom:0 !important}",
  "slots": [
    {
      "id": "label",
      "kind": "text",
      "label": "Текст кнопки",
      "default": "Перейти",
      "uiGroup": "content"
    },
    {
      "id": "href",
      "kind": "url",
      "label": "Ссылка",
      "default": "https://api.trade.iqbroker.com/v1/multi-links/open-asset?aff=7",
      "uiGroup": "content"
    },
    {
      "id": "background_color",
      "kind": "color",
      "label": "Цвет кнопки",
      "default": "#FF5500",
      "uiGroup": "appearance"
    },
    {
      "id": "text_color",
      "kind": "color",
      "label": "Цвет текста",
      "default": "#F9F9F9",
      "uiGroup": "appearance"
    },
    {
      "id": "radius",
      "kind": "select",
      "label": "Скругление",
      "default": "12px",
      "options": [
        "0",
        "8px",
        "12px",
        "16px",
        "24px"
      ],
      "uiGroup": "appearance"
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "center",
      "options": [
        "left",
        "center",
        "right"
      ],
      "uiGroup": "appearance"
    }
  ],
  "outlookSafe": true,
  "tags": [
    "iqbroker",
    "cta"
  ],
  "note": "Нарезано из email-base/X_IQBroker/mail-strategies. Семейные стили втянуты в блок и заскоуплены; ink-классы (.row/.columns/.wrapper) оставлены глобальными.",
  "scoped": true
}
