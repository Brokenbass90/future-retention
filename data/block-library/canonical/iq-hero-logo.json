{
  "id": "iq-hero-logo",
  "label": "Hero — логотип",
  "description": "Самостоятельный email-safe логотип для media-зоны hero. Картинка, ссылка, alt, ширина, отступы и скругление редактируются отдельно.",
  "placement": "inner",
  "category": "hero",
  "version": 2,
  "pug": "table.iq-hero-logo--iq-hero-logo(role=\"presentation\" width=\"100%\")\n    tr\n        td(align=\"{{ align }}\" style=\"padding:{{ padding }};text-align:{{ align }}\")\n            a(href=\"{{ href }}\" universal=\"true\" target=\"_blank\")\n                img.iq-hero-logo--iq-hero-logo-image(src=\"{{ image }}\" alt=\"{{ alt }}\" width=\"{{ width }}\" style=\"border:0;border-radius:{{ radius }};display:inline-block;height:auto;max-width:{{ width }}px\")",
  "styl": ".iq-hero-logo--iq-hero-logo{width:100%}\n.iq-hero-logo--iq-hero-logo-image{border:0;display:inline-block;float:none;height:auto;margin:0;max-width:{{ width }}px}",
  "slots": [
    {
      "id": "image",
      "kind": "image",
      "label": "Логотип",
      "default": "https://fsms.quadcode.com/storage/public/d6/nu/493ursrq72d917kg/logo.png",
      "uiGroup": "assets"
    },
    {
      "id": "href",
      "kind": "url",
      "label": "Ссылка логотипа",
      "default": "#",
      "uiGroup": "content"
    },
    {
      "id": "alt",
      "kind": "text",
      "label": "Alt-текст",
      "default": "IQ Option",
      "uiGroup": "content"
    },
    {
      "id": "width",
      "kind": "number",
      "label": "Ширина, px",
      "default": 138,
      "min": 40,
      "max": 320,
      "uiGroup": "appearance"
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "center",
      "options": [
        "left",
        "center",
        "right"
      ],
      "uiGroup": "appearance"
    },
    {
      "id": "padding",
      "kind": "text",
      "label": "Отступы",
      "default": "32px 0 0",
      "uiGroup": "appearance"
    },
    {
      "id": "radius",
      "kind": "select",
      "label": "Скругление",
      "default": "0",
      "options": [
        "0",
        "8px",
        "16px",
        "24px"
      ],
      "uiGroup": "appearance"
    }
  ],
  "outlookSafe": true,
  "tags": [
    "hero",
    "logo",
    "image",
    "inner",
    "iq"
  ],
  "scoped": true
}
