{
  "id": "sys-section",
  "label": "Секция письма",
  "description": "Контейнер простого письма: карточка на фоне бренда. Внутрь кладутся заголовок, текст, кнопка и остальное.",
  "placement": "section",
  "category": "layout",
  "version": 1,
  "pug": "table.sys-section--box(role=\"presentation\" width=\"100%\" style=\"background-color:{{ background_color }};border:{{ border }};border-radius:{{ radius }}\")\n    tr\n        td.sys-section--pad(style=\"padding:{{ padding }};text-align:{{ align }}\")\n            //- {{ INNER_BLOCKS }}",
  "styl": ".sys-section--box{display:table;width:100%;padding:0;border-collapse:separate !important;background-color:$brand_surface}\n.sys-section--pad{font-family:Helvetica,Arial,sans-serif;padding:{{ padding }}}\n@media screen and (max-width: 600px){.sys-section--pad{padding:24px 20px !important}}",
  "slots": [
    {
      "id": "background_color",
      "kind": "color",
      "label": "Фон секции — пусто значит «по теме бренда»",
      "default": "",
      "uiGroup": "appearance"
    },
    {
      "id": "border",
      "kind": "text",
      "label": "Обводка",
      "default": "none",
      "uiGroup": "appearance"
    },
    {
      "id": "gap",
      "kind": "number",
      "label": "Отступ между блоками, px (0 — вплотную)",
      "default": 16,
      "uiGroup": "appearance",
      "min": 0,
      "max": 120
    },
    {
      "id": "radius",
      "kind": "select",
      "label": "Скругление",
      "default": "16px",
      "uiGroup": "appearance",
      "options": [
        "0",
        "4px",
        "8px",
        "12px",
        "16px",
        "24px"
      ]
    },
    {
      "id": "padding",
      "kind": "text",
      "label": "Внутренние отступы",
      "default": "32px 40px",
      "uiGroup": "appearance"
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "left",
      "uiGroup": "appearance",
      "options": [
        "left",
        "center",
        "right"
      ]
    }
  ],
  "kits": [
    "system",
    "promo"
  ],
  "outlookSafe": true,
  "tags": [
    "layout",
    "section"
  ],
  "note": "Системный набор: блок написан с нуля под простые сервисные письма. Базовые цвета берутся из темы бренда ($brand_*), поэтому один и тот же блок читается и на светлом IQ Option, и на тёмном IQ Broker. Пустое значение цветового слота = «по бренду».",
  "scoped": true,
  "childSlots": [
    {
      "id": "content",
      "marker": "INNER_BLOCKS",
      "accepts": [
        "inner",
        "inline",
        "both"
      ]
    }
  ]
}
