{
  "id": "iq-socials",
  "label": "Соцсети (ссылки по локалям)",
  "description": "Самостоятельный email-safe ряд соцсетей. Локализованные ссылки, иконки, alt-тексты, размер, интервалы и отступы редактируются; системные плейсхолдеры разрешены только у localizedUrl.",
  "placement": "inner",
  "category": "footer",
  "version": 2,
  "source": "canonical",
  "pug": "table.iq-socials(role=\"presentation\" align=\"{{ align }}\")\n    tr\n        td.iq-socials-cell(align=\"{{ align }}\" style=\"padding:{{ padding }};text-align:{{ align }}\")\n            a.iq-social-link(href=\"{{ link_0 }}\" universal=\"true\" target=\"_blank\")\n                img.iq-social-icon(src=\"{{ icon_0 }}\" alt=\"{{ alt_0 }}\" width=\"{{ icon_size }}\")\n            a.iq-social-link(href=\"{{ link_1 }}\" universal=\"true\" target=\"_blank\")\n                img.iq-social-icon(src=\"{{ icon_1 }}\" alt=\"{{ alt_1 }}\" width=\"{{ icon_size }}\")\n            a.iq-social-link(href=\"{{ link_2 }}\" universal=\"true\" target=\"_blank\")\n                img.iq-social-icon(src=\"{{ icon_2 }}\" alt=\"{{ alt_2 }}\" width=\"{{ icon_size }}\")\n            a.iq-social-link(href=\"{{ link_3 }}\" universal=\"true\" target=\"_blank\")\n                img.iq-social-icon(src=\"{{ icon_3 }}\" alt=\"{{ alt_3 }}\" width=\"{{ icon_size }}\")",
  "styl": ".iq-socials{border-collapse:collapse}\n.iq-socials-cell{font-size:0;line-height:0;text-align:{{ align }}}\n.iq-social-link{display:inline-block;margin:0 {{ gap }}px;text-decoration:none;vertical-align:middle}\n.iq-social-icon{border:0;display:inline-block;float:none!important;height:auto;max-width:{{ icon_size }}px}\n@media screen and (max-width:600px){.iq-socials{width:100%!important}.iq-social-link{margin-bottom:10px!important}}",
  "slots": [
    { "id": "link_0", "kind": "localizedUrl", "label": "Ссылка 1 (по локалям)", "perLocale": true, "default": "#", "allowSystemPlaceholder": true, "uiGroup": "content" },
    { "id": "icon_0", "kind": "image", "label": "Иконка 1", "default": "https://fsms.quadcode.com/storage/public/d5/ka/q8fvhhge5gv5vatg/tiktok-logo.png", "uiGroup": "assets" },
    { "id": "alt_0", "kind": "text", "label": "Alt иконки 1", "default": "TikTok", "uiGroup": "content" },
    { "id": "link_1", "kind": "localizedUrl", "label": "Ссылка 2 (по локалям)", "perLocale": true, "default": "#", "allowSystemPlaceholder": true, "uiGroup": "content" },
    { "id": "icon_1", "kind": "image", "label": "Иконка 2", "default": "https://fsms.iqoption.com/storage/public/cn/td/fri03qqv4qln7ve0/ig.png", "uiGroup": "assets" },
    { "id": "alt_1", "kind": "text", "label": "Alt иконки 2", "default": "Instagram", "uiGroup": "content" },
    { "id": "link_2", "kind": "localizedUrl", "label": "Ссылка 3 (по локалям)", "perLocale": true, "default": "#", "allowSystemPlaceholder": true, "uiGroup": "content" },
    { "id": "icon_2", "kind": "image", "label": "Иконка 3", "default": "https://fsms.iqoption.com/storage/public/cn/td/gb285cee2vclvjq0/yt.png", "uiGroup": "assets" },
    { "id": "alt_2", "kind": "text", "label": "Alt иконки 3", "default": "YouTube", "uiGroup": "content" },
    { "id": "link_3", "kind": "localizedUrl", "label": "Ссылка 4 (по локалям)", "perLocale": true, "default": "#", "allowSystemPlaceholder": true, "uiGroup": "content" },
    { "id": "icon_3", "kind": "image", "label": "Иконка 4", "default": "https://fsms.quadcode.com/storage/public/d5/ka/rf7vhhge5gv5vau0/tg.png", "uiGroup": "assets" },
    { "id": "alt_3", "kind": "text", "label": "Alt иконки 4", "default": "Telegram", "uiGroup": "content" },
    { "id": "icon_size", "kind": "number", "label": "Размер иконок, px", "default": 24, "min": 12, "max": 64, "uiGroup": "appearance" },
    { "id": "gap", "kind": "number", "label": "Интервал, px", "default": 10, "min": 0, "max": 32, "uiGroup": "appearance" },
    { "id": "padding", "kind": "text", "label": "Отступы", "default": "0", "uiGroup": "appearance" },
    { "id": "align", "kind": "select", "label": "Выравнивание", "default": "center", "options": ["left", "center", "right"], "uiGroup": "appearance" }
  ],
  "outlookSafe": true,
  "tags": ["socials", "footer", "per-locale", "iq"]
}
