{
  "id": "iq-note-gray",
  "label": "Серая сноска",
  "description": "p.small-gray-text — мелкий серый пояснительный текст.",
  "placement": "inner",
  "category": "text",
  "version": 3,
  "outlookSafe": true,
  "pug": "p.iq-note-gray--small-gray-text.iq-note-gray--pt5.iq-note-gray(style=\"text-align:{{ align }}\") {{ text }}",
  "styl": ".iq-note-gray--small-gray-text\n  font-family: Helvetica !important\n  font-style: normal\n  font-weight: 400\n  font-size: 16px\n  line-height: 24px\n  color: #84868B\n\n/* втянуто из стилей семьи при скоупе — блок больше не зависит от main.styl */\n.iq-note-gray--pt5{padding-top:5px}",
  "slots": [
    {
      "id": "text",
      "kind": "text",
      "label": "Текст сноски",
      "default": "Small note text",
      "uiGroup": "content"
    },
    {
      "id": "align",
      "kind": "select",
      "label": "Выравнивание",
      "default": "left",
      "options": [
        "left",
        "center",
        "right"
      ],
      "uiGroup": "appearance"
    }
  ],
  "scoped": true
}
