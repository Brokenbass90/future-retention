OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_DISCUSSION=gpt-4.1-mini
OPENAI_MODEL_TRANSLATIONS=gpt-4.1-mini
OPENAI_MODEL_DRAFT=gpt-5.4
OPENAI_MODEL_DESIGN_ANALYSIS=gpt-5.4
OPENAI_MODEL_CLONE_EDIT=gpt-5.4
OPENAI_MODEL_FOLLOWUP_EDIT=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2

# Единый безопасный режим публичного демо: отключает Basic Auth и все AI-вызовы.
# Для закрытого окружения оставь 0 и управляй функциями отдельными флагами.
STUDIO_PUBLIC_DEMO=0
STUDIO_AI_ENABLED=1
APP_AUTH_ENABLED=1

# Необязательный локальный text-first backend для чата, draft JSON и переводов.
# Vision-анализ и constructor tool-agent пока остаются OpenAI-only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
FIGMA_API_TOKEN=
FIGMA_IMPORT_SECRET=
APP_AUTH_USER=
APP_AUTH_PASSWORD=
PREVIEW_BUILD_CONCURRENCY=2
PREVIEW_BUILD_CACHE_ENTRIES=80
PREVIEW_BUILD_CACHE_TTL_MS=30000

# ─── Хранилище картинок ──────────────────────────────────────────────────────
# local (по умолчанию): файлы в data/assets, адрес /studio-assets/<имя>.
#   Работает для превью и вёрстки, но в реальной рассылке картинку не увидят —
#   адрес относительный. На хостинге с эфемерным диском файлы ещё и пропадают.
# s3: S3-совместимое хранилище, постоянный публичный URL.
#ASSET_STORAGE=s3
#ASSET_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#ASSET_S3_BUCKET=retkit-assets
#ASSET_S3_REGION=auto
#ASSET_S3_ACCESS_KEY_ID=
#ASSET_S3_SECRET_ACCESS_KEY=
#ASSET_S3_PUBLIC_BASE=https://cdn.example.com
#ASSET_S3_PREFIX=assets
