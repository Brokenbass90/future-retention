table.row.header
    tr
        td.wrapper
            table.six.columns
                tr
                    td.left
                        a(href="https://iqoption.com/traderoom/?aff=7&afftrack=mail&retrack=system", target="_blank")
                            img.logo(src="https://images01.iqoption.com/89/0689/static-01503674720413810689.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/id871125783?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/21/8721/static-00636246823765278721.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/com.iqoption?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/17/9217/static-01920501695922569217.png")

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.no-padding-bottom
                        p.title Account Manager for Chinese speaking clients

                        p.text Hello!

                        p.text Unfortunately, we can not currently provide a Chinese speaking Account Manager for you. However, if you speak English we would be happy to assign you to an English Account Manager. If you only speak Chinese, our wonderful support specialists will be happy to assist you if you happen to have any questions.

                        p.text Best regards
                            br
                            | IQ Option Team




