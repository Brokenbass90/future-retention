table.row.header
    tr
        td.wrapper
            table.six.columns
                tr
                    td.left
                        a(href="https://iqoption.com/traderoom/?aff=7&afftrack=mail&retrack=net-wealth", target="_blank")
                            img.logo(src="https://images01.iqoption.com/89/0689/static-01503674720413810689.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/id871125783?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/21/8721/static-00636246823765278721.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/com.iqoption?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/17/9217/static-01920501695922569217.png")

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.no-padding-bottom
                        p.title Dear Client,

                        p.text During the verification of your account it came to our attention that there is a mismatch in your Economic Profile between your net wealth and your deposits. Please note that by net wealth is meant cash, assets, real estate etc.

                        p.text Kindly confirm which of following applies as your net wealth:

                        p.text.list €300,000 +

                        p.text.list €100,001 - €300,000

                        p.text.list €30,001 - €100,000

                        p.text.list.pb20 €0 - €30,000

                        p.text
                            strong Please reply to&nbsp;
                            a(href="mailto:compliance@iqoption.com", target="_blank") compliance@iqoption.com

                        p.text We appreciate your cooperation on this matter.

                        p.text Kind regards,
                            br
                            | The IQ Option Team




