table.row.header
    tr
        td.wrapper
            table.six.columns
                tr
                    td.left
                        a(href="https://iqoption.com/traderoom/?aff=7&afftrack=mail&retrack=demo-positions", target="_blank")
                            img.logo(src="https://images01.iqoption.com/21/7921/static-02738020799133777921.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/id871125783?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/21/8721/static-00636246823765278721.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/com.iqoption?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/17/9217/static-01920501695922569217.png")

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.no-padding-bottom
                        p.title ${{ demo.block_00 }}$

                        p.text ${{ demo.block_01 }}$
                        p.text ${{ demo.block_02 }}$
                        p.text ${{ demo.block_03 }}$
                        p.text ${{ demo.block_04 }}$
                        p.text ${{ demo.block_05 }}$&nbsp;
                            a(href="https://iqoption.com/tickets", target="_blank") ${{ demo.block_06 }}$

                        p.text ${{ demo.block_07 }}$


