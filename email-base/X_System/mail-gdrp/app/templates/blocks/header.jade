table.row.header
    tr
        td.wrapper
            table.six.columns
                tr
                    td.left
                        a(href="https://iqoption.com/traderoom/?aff=7&afftrack=mail&retrack=demo-positions", target="_blank")
                            img.logo(src="https://images01.iqoption.com/89/0689/static-01503674720413810689.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/id871125783?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/21/8721/static-00636246823765278721.png")
        td.wrapper.last.hide-for-small
            table.three.columns
                tr
                    td.apps
                        a(href="https://app.appsflyer.com/com.iqoption?pid=7&c=mail")
                            img.app_btn(src="https://images01.iqoption.com/17/9217/static-01920501695922569217.png")

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.no-padding-bottom
                        p.title.center ${{ gdpr.block_00 }}$

                        p.text ${{ gdpr.block_01 }}$&nbsp;
                            a(href="https://eu.iqoption.com/terms-and-conditions/terms-conditions", target="_blank") ${{ gdpr.block_02 }}$
                            | &nbsp;${{ gdpr.block_03 }}$&nbsp;
                            a(href="https://eu.iqoption.com/terms-and-conditions/privacy-policy-new", target="_blank") ${{ gdpr.block_04 }}$
                            | &nbsp;${{ gdpr.block_05 }}$

table.row.white-bg
    tr
        td.wrapper.last
            table.twelve.columns
                tr
                    td.plr30.pb30
                        .blue-block
                            p.text.center ${{ gdpr.block_06 }}$
                            p.text.icon-text.icon-text_1 ${{ gdpr.block_07 }}$
                            p.text.icon-text.icon-text_2 ${{ gdpr.block_08 }}$
                            p.text.center ${{ gdpr.block_09 }}$

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.text-pad-small
                        p.orange-text.center ${{ gdpr.block_10 }}$

table.row.white-bg
    tr
        td.offset-by-three
            table.six.columns
                tr
                    td
                        .button-wrapper
                            table.medium-button.radius
                                tr
                                    td.iq
                                        a.butt(href="https://eu.iqoption.com/profile/subscribes") ${{ gdpr.block_11 }}$

table.row.white-bg
    tr
        td.offset-by-one
            table.ten.columns
                tr
                    td.text-pad-small
                        p.grey-text.center.pb20 ${{ gdpr.block_12 }}$&nbsp;
                            a(href="https://iqoption.com/tickets", target="_blank") ${{ gdpr.block_13 }}$
                            | &nbsp;${{ gdpr.block_14 }}$
                        p.blue-text.center ${{ gdpr.block_15 }}$



