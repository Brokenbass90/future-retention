// Global head-extra styles.
//
// Purpose:
// - This file is ALWAYS included into <head> (NOT filtered).
// - It ALSO participates in inlining (same rules are applied inline where possible).
//
// Typical use cases:
// - “must be in head” rules that you ALSO want inline.
// - dark-mode / client-specific tweaks that depend on head context.
//
// Keep it minimal.

// ── Gmail dark mode: защита от инверсии цвета ─────────────────────────────
// Обернуть контент в div.gmail-blend-screen > div.gmail-blend-diff.
// Селектор u + .body срабатывает только в Gmail; в остальных клиентах
// обёртки-div полностью инертны.
u + .body .gmail-blend-screen
  background: #000000
  mix-blend-mode: screen
u + .body .gmail-blend-diff
  background: #000000
  mix-blend-mode: difference
